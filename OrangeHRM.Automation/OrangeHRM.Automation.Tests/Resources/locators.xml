<locators>

	<LoginPage>

		<Username>
			<LocatorType>XPATH</LocatorType>
			<LocatorValue>//input[@name='username1']</LocatorValue>
		</Username>

		<Password>
			<LocatorType>XPATH</LocatorType>
			<LocatorValue>//input[@name='password']</LocatorValue>
		</Password>

		<LoginButton>
			<LocatorType>XPATH</LocatorType>
			<LocatorValue>//button[@type='submit']</LocatorValue>
		</LoginButton>
		<InvalidCredentialsMessage>
			<LocatorType>XPATH</LocatorType>
			<LocatorValue>//p[contains(@class,'oxd-alert-content-text')]</LocatorValue>
		</InvalidCredentialsMessage>
		<UsernameRequiredErrorMessage>
			<LocatorType>XPATH</LocatorType>
			<LocatorValue>//div/input[@placeholder='Username']/parent::div/following-sibling::span[contains(@class,'oxd-input-field-error-message')]</LocatorValue>
		</UsernameRequiredErrorMessage>
		<PasswordRequiredErrorMessage>
			<LocatorType>XPATH</LocatorType>
			<LocatorValue>//div/input[@placeholder='Password']/parent::div/following-sibling::span[contains(@class,'oxd-input-field-error-message')]</LocatorValue>
		</PasswordRequiredErrorMessage>
